{
  "name": "OldTweetDeck",
  "description": "Returns old TweetDeck!",
  "version": "4.4.0.1",
  "manifest_version": 2,
  "homepage_url": "https://github.com/dimdenGD/OldTweetDeck",
  "permissions": [
    "webNavigation",
    "cookies",
    "declarativeNetRequest",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://abs.twimg.com/*",
    "https://api.twitter.com/*",
    "https://tweetdeck.com/",
    "https://oldtd.org/*",
    "https://tweetdeck.dimden.dev/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "web_accessible_resources": [
    "images/*",
    "files/*",
    "src/*",
    "solver.html",
    "manifest.json"
  ],
  "icons": {
    "16": "/images/logo16.png",
    "32": "/images/logo32.png",
    "48": "/images/logo48.png",
    "128": "/images/logo128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/i/tweetdeck",
        "https://x.com/i/tweetdeck",
        "https://x.com/i/tweetdeck?*"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://twitter.com/i/tweetdeck",
        "https://x.com/i/tweetdeck",
        "https://x.com/i/tweetdeck?*"
      ],
      "js": [
        "src/notifications.js",
        "src/injection.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "oldtweetdeck@dimden.dev",
      "strict_min_version": "90.0"
    }
  }
}
